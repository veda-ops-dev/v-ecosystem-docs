#!/bin/sh
# VedaOps pre-commit hook — text artifact integrity check
#
# Runs vcheck against every staged .md file.
# Blocks the commit if any blocking failure is found.
#
# Install: copy this file to .git/hooks/pre-commit and make it executable.
#   cp hooks/pre-commit .git/hooks/pre-commit
#   chmod +x .git/hooks/pre-commit

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT" || exit 1

staged=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null | grep '\.md$')

if [ -z "$staged" ]; then
  exit 0
fi

python tools/vcheck.py --sweep $staged
exit_code=$?

if [ $exit_code -eq 1 ]; then
  echo ""
  echo "vcheck: commit blocked — fix the errors above before committing."
  exit 1
fi

# Warnings (exit code 2) do not block the commit.
exit 0
